# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database ----
DB_URI=mongodb://127.0.0.1:27017/whisperly

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=1d

# ---- Password hashing ----
SALT_ROUNDS=10

# ---- Login lockout (stored in Redis) ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ---- OTP ----
# OTP codes are stored in Redis; this value is used as the key's TTL.
OTP_EXPIRES_IN_MINUTES=10

# ---- Email ----
# Which provider the email factory builds: gmail (real emails) | console (just logs them)
EMAIL_PROVIDER=gmail
EMAIL_USER=Yostinaashiaa@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=Whisperly <Yostinaashiaa@gmail.com>

# ---- Redis ----
# Required: OTP codes live here with an automatic TTL (see OTP section above).
# It also backs response caching; if Redis is down, caching is skipped but
# OTP-based flows (register / confirm / reset password) will return 503.
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60
