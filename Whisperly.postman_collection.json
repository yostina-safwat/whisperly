{
  "info": {
    "name": "Whisperly API",
    "_postman_id": "b1f7c0e2-9a3d-4a1b-8c7e-whisperly0001",
    "description": "Whisperly - anonymous messaging (Saraha-style) app with full authentication.\n\nSet the `baseUrl` variable (default http://localhost:3000). After a successful Login, the `token` variable is filled automatically by the login test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "receiverId", "value": "", "type": "string" },
    { "key": "messageId", "value": "", "type": "string" },
    { "key": "requestId", "value": "", "type": "string" },
    { "key": "conversationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\",\n  \"confirmPassword\": \"secret123\",\n  \"phone\": \"01000000000\",\n  \"gender\": \"female\"\n}"
            }
          }
        },
        {
          "name": "Confirm Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/confirm-email", "host": ["{{baseUrl}}"], "path": ["auth", "confirm-email"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  if (res.data.user && res.data.user._id) {",
                  "    pm.collectionVariables.set('receiverId', res.data.user._id);",
                  "  }",
                  "  pm.test('Token saved', () => pm.expect(res.data.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Verify Login (two-step)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.test('Token saved', () => pm.expect(res.data.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login/verify", "host": ["{{baseUrl}}"], "path": ["auth", "login", "verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Enable Two-Step",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/two-step/enable", "host": ["{{baseUrl}}"], "path": ["auth", "two-step", "enable"] }
          }
        },
        {
          "name": "Confirm Two-Step",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/two-step/confirm", "host": ["{{baseUrl}}"], "path": ["auth", "two-step", "confirm"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Disable Two-Step",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/two-step/disable", "host": ["{{baseUrl}}"], "path": ["auth", "two-step", "disable"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["auth", "resend-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"type\": \"confirmEmail\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newsecret123\",\n  \"confirmPassword\": \"newsecret123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/user/profile", "host": ["{{baseUrl}}"], "path": ["user", "profile"] }
          }
        },
        {
          "name": "My Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/user/messages", "host": ["{{baseUrl}}"], "path": ["user", "messages"] }
          }
        },
        {
          "name": "Public Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/user/{{receiverId}}", "host": ["{{baseUrl}}"], "path": ["user", "{{receiverId}}"] }
          }
        },
        {
          "name": "Upload Profile Image",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/user/profile/image", "host": ["{{baseUrl}}"], "path": ["user", "profile", "image"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "description": "Upload or replace the profile picture. Choose an image file for the `image` field. Validated by file filter + magic numbers; returns the stored path and a public URL."
          }
        }
      ]
    },
    {
      "name": "Message",
      "item": [
        {
          "name": "Send Anonymous Whisper",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "  pm.collectionVariables.set('messageId', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/message/{{receiverId}}", "host": ["{{baseUrl}}"], "path": ["message", "{{receiverId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"You are doing great, keep going! 🤫\"\n}"
            }
          }
        },
        {
          "name": "Delete My Message",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/message/{{messageId}}", "host": ["{{baseUrl}}"], "path": ["message", "{{messageId}}"] }
          }
        }
      ]
    },
    {
      "name": "Request",
      "item": [
        {
          "name": "Send Chat Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data._id) pm.collectionVariables.set('requestId', res.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/request/{{receiverId}}", "host": ["{{baseUrl}}"], "path": ["request", "{{receiverId}}"] }
          }
        },
        {
          "name": "Received Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/request", "host": ["{{baseUrl}}"], "path": ["request"] }
          }
        },
        {
          "name": "Sent Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/request/sent", "host": ["{{baseUrl}}"], "path": ["request", "sent"] }
          }
        },
        {
          "name": "Accept / Reject Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.conversation && res.data.conversation._id) pm.collectionVariables.set('conversationId', res.data.conversation && res.data.conversation._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/request/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["request", "{{requestId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            }
          }
        },
        {
          "name": "Cancel Request",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/request/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["request", "{{requestId}}"] }
          }
        }
      ]
    },
    {
      "name": "Conversation",
      "item": [
        {
          "name": "My Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/conversation", "host": ["{{baseUrl}}"], "path": ["conversation"] }
          }
        },
        {
          "name": "Conversation Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/conversation/{{conversationId}}/messages", "host": ["{{baseUrl}}"], "path": ["conversation", "{{conversationId}}", "messages"] }
          }
        },
        {
          "name": "Send Message in Conversation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/conversation/{{conversationId}}/messages", "host": ["{{baseUrl}}"], "path": ["conversation", "{{conversationId}}", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hey 👋\"\n}"
            }
          }
        }
      ]
    }
  ]
}
